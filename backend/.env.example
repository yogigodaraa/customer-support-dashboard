# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wesupport"

# Server
PORT=3001
NODE_ENV="development"
JWT_SECRET="your-secret-key-change-in-production"

# API Key guard (optional — leave blank for open access in development)
# When set, all /api/* requests must include: Authorization: Bearer <API_SECRET>
API_SECRET=""

# AI Assistant — get your key at https://console.anthropic.com
# When set, the AI panel uses real Claude responses; when blank, mock responses are returned
ANTHROPIC_API_KEY=""

# API Integrations
FRONT_API_KEY="your-front-api-key"
INTERCOM_ACCESS_TOKEN="your-intercom-access-token"
LUCIQ_API_KEY="your-luciq-api-key"
RETOOL_API_KEY="your-retool-api-key"

# Intercom webhook signature secret (from Intercom Developer Hub → Webhooks)
# Leave blank to skip signature validation during local development
INTERCOM_WEBHOOK_SECRET=""

# Frontend
FRONTEND_URL="http://localhost:3000"
